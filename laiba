<!DO
CTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Laiba Quran Academy</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f7f9fb;
      color: #333;
    }
    header {
      background-color: #134e4a;
      color: white;
      padding: 2rem;
      text-align: center;
    }
    header h1 {
      margin: 0;
      font-size: 2.5rem;
    }
    nav {
      text-align: center;
      padding: 1rem;
      background-color: #e2f0ee;
    }
    nav a {
      margin: 0 1rem;
      color: #134e4a;
      text-decoration: none;
      font-weight: 600;
    }
    .container {
      max-width: 900px;
      margin: auto;
      padding: 2rem;
    }
    section {
      margin-bottom: 3rem;
    }
    h2 {
      color: #134e4a;
    }
    .pricing {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }
    .plan {
      border: 1px solid #ddd;
      padding: 1rem;
      border-radius: 8px;
      background-color: white;
    }
    .cta {
      text-align: center;
      margin-top: 2rem;
    }
    .cta a {
      background-color: #134e4a;
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 5px;
      text-decoration: none;
      font-weight: bold;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 500px;
      margin: 2rem auto 0;
      background: #fff;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    input, textarea {
      padding: 0.75rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 1rem;
    }
    button {
      background-color: #134e4a;
      color: white;
      padding: 0.75rem;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
    }
    footer {
      text-align: center;
      padding: 1.5rem;
      background-color: #e2f0ee;
      color: #555;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <header>
    <h1>Laiba Quran Academy</h1>
    <p>Personalized Quran Learning for Kids and Adults Worldwide</p>
  </header>
  <nav>
    <a href="#about">About</a>
    <a href="#classes">Classes</a>
    <a href="#pricing">Pricing</a>
    <a href="#contact">Contact</a>
  </nav>
  <div class="container">
    <section id="about">
      <h2>About Me</h2>
      <p>I'm Laiba, a 19-year-old passionate Quran teacher currently pursuing my Bachelor's degree. I specialize in teaching the Holy Quran with Tajweed, Hifz, and basic Islamic studies to children and adults across the globe. With fluency in both English and Urdu, I offer engaging and personalized online classes that make Quran learning accessible, easy, and spiritually uplifting.</p>
    </section>

    <section id="classes">
      <h2>What I Offer</h2>
      <ul>
        <li>Quran Reading with Tajweed</li>
        <li>Memorization (Hifz) Support</li>
        <li>Basic Islamic Teachings</li>
        <li>One-on-One or Group Classes</li>
        <li>Flexible Schedules</li>
        <li>Friendly, Professional Environment</li>
      </ul>
    </section>

    <section id="pricing">
      <h2>Pricing (USD & GBP)</h2>
      <div class="pricing">
        <div class="plan">
          <h3>2 Classes/Week</h3>
          <p>$25 / £25 per month</p>
        </div>
        <div class="plan">
          <h3>3 Classes/Week</h3>
          <p>$35 / £35 per month</p>
        </div>
        <div class="plan">
          <h3>5 Classes/Week</h3>
          <p>$50 / £50 per month</p>
        </div>
      </div>
    </section>

    <section id="contact">
      <h2>Contact Me</h2>
      <p>Ready to start learning? Book a free trial class or sign up below!</p>
      <p><strong>WhatsApp:</strong> <a href="https://wa.me/923178701719" target="_blank">+92 317 8701719</a></p>
      <p><strong>Email:</strong> your.email@example.com</p>

      <form action="#" method="post">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" required />

        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required />

        <label for="number">WhatsApp Number</label>
        <input type="text" id="number" name="number" required />

        <label for="message">Your Message</label>
        <textarea id="message" name="message" rows="4" placeholder="E.g., I’m interested in 3 classes/week for my child..."></textarea>

        <button type="submit">Submit</button>
      </form>

      <div class="cta">
        <a href="https://wa.me/923178701719">Book Free Trial</a>
      </div>
    </section>
  </div>
  <footer>
    &copy; 2025 Laiba Quran Academy. All rights reserved.
  </footer>
</body>
</html>
